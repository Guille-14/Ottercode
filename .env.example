# OtterCode — copia a .env si quieres. Ollama va en su propio proceso.
OTTERCODE_LLM_BACKEND=ollama
OTTERCODE_OLLAMA=http://127.0.0.1:11434
OTTERCODE_HOST=127.0.0.1
OTTERCODE_PORT=8000
OTTERCODE_MODEL=qwen2.5-coder:7b
OTTERCODE_NUM_CTX=16384
OTTERCODE_NUM_PREDICT=4096
OTTERCODE_KEEP_ALIVE=15m
OTTERCODE_ASK_PERMISSIONS=1
OTTERCODE_SANDBOX_REQUIRED=1
OTTERCODE_NATIVE_TOOLS=auto
OTTERCODE_MAX_TOOL_STEPS=60
OTTERCODE_FLUSH_EVERY_TURN=0
# OTTERCODE_API está deprecado. No pongas una URL aquí.

# En el daemon Ollama (no en este backend):
# OLLAMA_FLASH_ATTENTION=1
# OLLAMA_KV_CACHE_TYPE=q8_0
# OLLAMA_MAX_LOADED_MODELS=1
# OLLAMA_NUM_PARALLEL=1
